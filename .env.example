APP_NAME=Media Hub API
DEBUG=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400
MAX_EXTRACT_SECONDS=75
MAX_MERGE_SECONDS=900
MEDIA_DIR=/tmp/mediahub_media
MEDIA_TTL_SECONDS=1800
LOG_LEVEL=INFO
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_SECONDS=600
RENDER_EXTERNAL_URL=https://media-hub-backend.onrender.com
